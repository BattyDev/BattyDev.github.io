{
  "name": "batty-gwent",
  "private": true,
  "version": "0.1.0",
  "description": "Fan-made Gwent simulator for practising the hard matches in The Witcher 3.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:data": "vitest run test/data",
    "art": "python3 -I tools/build_art.py",
    "bench": "vitest run --config vitest.bench.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
